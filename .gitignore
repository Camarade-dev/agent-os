benchmark/reports/gemini_demo_trace.html
benchmark/reports/terminal_agent_dry_run_trace.json
benchmark/reports/terminal_agent_dry_run_trace.html
benchmark/reports/admissible_long_run_truth_console.html
benchmark/reports/admissible_long_run_truth_console_trace.json
benchmark/reports/admissible_long_run_builder_truth_console.html
benchmark/reports/admissible_long_run_builder_truth_console_trace.json
benchmark/reports/admissible_cursor_real_capture_truth_console.html
benchmark/reports/admissible_cursor_real_capture_truth_console_trace.json
benchmark/reports/admissible_cursor_admitted_execution_truth_console.html
benchmark/reports/admissible_cursor_admitted_execution_truth_console_trace.json

# Admissible V0 runtime advisory locks are machine-local control state,
# never committed evidence. Defense-in-depth: never let one into the archive.
*.runtime.lock

# Admissible V0 disposition advisory locks are machine-local control state,
# never committed evidence. Defense-in-depth: never let one into the review dir.
*.disposition.lock
